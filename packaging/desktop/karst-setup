# Runs as the desktop user. Only the fixed setup helper receives elevated
# privileges; the invitation is passed on stdin, never in argv or a file.
set -uo pipefail

# Identify the installed helper, independently of any still-running daemon.
client_version=$(/usr/bin/karst --version 2>/dev/null) || client_version='Unknown'
setup_title="Karst Setup — installed client: ${client_version:-Unknown}"

while true; do
    if [[ -f /etc/karst/karstd.toml ]]; then
        if message=$(/usr/bin/pkexec /usr/bin/karst setup --resume 2>&1); then
            if [[ "$message" == Connected.* ]]; then
                /usr/bin/zenity --info --title="$setup_title" --text="$message"
                exit 0
            fi
            if /usr/bin/zenity --question --title="$setup_title" --text="$message" --ok-label='Retry' --cancel-label='Close'; then
                continue
            fi
            exit 0
        fi
    else
        if ! invitation=$(/usr/bin/zenity --entry --title="$setup_title" --text='Paste the enrollment invitation from your administrator.' --hide-text --ok-label='Connect'); then
            exit 0
        fi
        if message=$(printf '%s' "$invitation" | /usr/bin/pkexec /usr/bin/karst setup --stdin 2>&1); then
            unset invitation
            if [[ "$message" == Connected.* ]]; then
                /usr/bin/zenity --info --title="$setup_title" --text="$message"
                exit 0
            fi
            if /usr/bin/zenity --question --title="$setup_title" --text="$message" --ok-label='Retry' --cancel-label='Close'; then
                continue
            fi
            exit 0
        fi
        unset invitation
    fi
    if ! /usr/bin/zenity --question --title="$setup_title" --text="${message:-Setup was canceled or operating-system permission was denied.}" --ok-label='Retry' --cancel-label='Close'; then
        exit 0
    fi
done
