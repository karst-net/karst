[Unit]
Description=Karst relay
Documentation=https://github.com/karst-net/karst
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/karst-relay --config /etc/karst/relay.toml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
