[Unit]
Description=Karst node agent
Documentation=https://github.com/karst-net/karst
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/karstd --config /etc/karst/karstd.toml
ExecStopPost=-/usr/bin/karst dns revert --config /etc/karst/karstd.toml
Restart=on-failure
RestartSec=2
# The control socket, and nothing that has to survive the daemon: systemd
# deletes this directory on every stop.
RuntimeDirectory=karst
RuntimeDirectoryMode=0700
# The netmap cache and the DNS revert record. systemd never removes a state
# directory, which is the whole point — the revert record describes how to undo
# a change to /etc/resolv.conf, so it has to outlive the stop that failed to
# apply it. GitHub issue [#67](https://github.com/karst-net/karst/issues/67).
StateDirectory=karst
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
