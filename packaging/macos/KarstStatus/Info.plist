  Template. scripts/build-macos-pkg.sh copies this into the built .app
  bundle and patches CFBundleShortVersionString/CFBundleVersion with the
  real package version via `plutil -replace` — the "0.0.0" here is never
  what ships.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Karst Status</string>
    <key>CFBundleDisplayName</key>
    <string>Karst Status</string>
    <key>CFBundleIdentifier</key>
    <string>dev.karst.karststatus</string>
    <key>CFBundleExecutable</key>
    <string>KarstStatus</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!--
      No Dock icon, no Cmd-Tab entry. Belt and suspenders alongside
      main.swift's programmatic NSApplication.setActivationPolicy(.accessory)
      — this is the declarative form, which some tooling and some macOS
      versions' window-server behavior look at before the app has even
      called into AppKit.
    -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright the Karst contributors. MIT OR Apache-2.0.</string>
</dict>
</plist>
