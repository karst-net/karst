#!/bin/bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright the Karst contributors.
#
# Fix ownership and, best-effort, start the menu-bar app for whoever is at
# the console right now.
#
# Best-effort throughout, deliberately. This runs as root under
# `installer`/`sudo installer`, which can happen with nobody in a GUI
# session at all — a fresh Mac being provisioned unattended, or (as in
# deliverables.yml's install-and-verify smoke test) a CI runner with no
# console user. Failing the whole package install because a per-user UI
# convenience could not start *immediately* would be a strange trade: the
# LaunchAgent's own `RunAtLoad` already starts it at the next login
# regardless of what happens here, so nothing is lost by not forcing it —
# and the install itself must still succeed on a headless box.

set -eu

PLIST="/Library/LaunchAgents/dev.karst.karststatus.plist"
APP="/Applications/Karst Status.app"

# launchd refuses a plist that is group- or world-writable — the same
# reason dev.karst.karstd's postinstall fixes its own plist's mode.
/bin/chmod 0644 "$PLIST"
/usr/sbin/chown root:wheel "$PLIST"
/usr/sbin/chown -R root:wheel "$APP"

console_user="$(stat -f%Su /dev/console 2>/dev/null || true)"
if [ -n "$console_user" ] && [ "$console_user" != "root" ]; then
    console_uid="$(id -u "$console_user" 2>/dev/null || true)"
    if [ -n "$console_uid" ]; then
        /bin/launchctl asuser "$console_uid" /bin/launchctl bootstrap \
            "gui/$console_uid" "$PLIST" 2>/dev/null \
            || /bin/launchctl asuser "$console_uid" /bin/launchctl load -w \
                "$PLIST" 2>/dev/null \
            || true
    fi
fi

exit 0
