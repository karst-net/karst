//
// Copied verbatim from packaging/macos/KarstPacketTunnel's own copy of
// uniffi-bindgen's generated output (see that directory's karst_ffiFFI.h
// header comment for regeneration instructions) — identical here since this
// wraps the same compiled karst-ffi library, nothing App-Extension-specific
// about the bindings themselves. The module name, `karst_ffiFFI`, is what
// karst_ffi.swift's `#if canImport(karst_ffiFFI)` checks for, so it must
// match exactly even though this SwiftPM target's own name (`CKarstFFI`,
// Package.swift) does not need to.
module karst_ffiFFI {
    header "karst_ffiFFI.h"
    export *
    use "Darwin"
    use "_Builtin_stdbool"
    use "_Builtin_stdint"
}
