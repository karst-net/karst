<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: MIT OR Apache-2.0
  Copyright the Karst contributors.

  Wired into scripts/build-macos-pkg.sh's codesign invocation for the
  packet-tunnel system-extension bundle (ADR-0026 item 7). The
  `com.apple.developer.networking.networkextension` entitlement below still
  does nothing without ADR-0026 item 1's actual entitlement application
  being granted — a build signed against this file today produces a bundle
  Apple's provisioning system refuses to trust — but the codesign step
  itself is real, not a placeholder, so nothing here needs re-deriving once
  item 1 lands.

  `packet-tunnel-provider-systemextension`, not the plain
  `packet-tunnel-provider` value: the array value naming applies specifically
  to a Developer ID-signed System Extension, which is
  docs/adr/0026-macos-network-extension-backend.md's own choice over an app
  extension — see that ADR's Decision item 5.

  `com.apple.application-identifier` / `com.apple.developer.team-identifier`
  added alongside Karst.entitlements' own copy of this fix (#159):
  `NETunnelProviderSession.sendProviderMessage` failed with `nesessionmanager`
  reporting the calling process not entitled to establish IPC, and neither
  entitlement was actually embedded in either signed bundle — Xcode injects
  them automatically from the provisioning profile; this project's manual
  codesign's own entitlements flag pointed at this file does not. Values match
  `packettunnel.provisionprofile`'s own `Entitlements` dict.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider-systemextension</string>
    </array>
    <key>com.apple.application-identifier</key>
    <string>WJ3MJC4KV7.dev.karst.packettunnel</string>
    <key>com.apple.developer.team-identifier</key>
    <string>WJ3MJC4KV7</string>
</dict>
</plist>
