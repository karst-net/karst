-->
<installer-gui-script minSpecVersion="2">
    <title>Karst</title>
    <organization>dev.karst</organization>

    <!--
      macOS 13 (Ventura). Stated rather than left open: supporting older costs
      testing time for a shrinking population, and an installer that runs on a
      release nobody tested is worse than one that declines politely.
    -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>

    <!--
      System volume only. The component's paths are absolute —
      /usr/local/bin, /Applications, /Library/LaunchAgents — so installing
      onto any other volume would produce a package whose files are not
      where its plist says.
    -->
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>

    <!--
      One component now, not two. There used to be a separate
      `dev.karst.karstd` LaunchDaemon component alongside this one —
      dropped once real device testing (#159) verified the
      NetworkExtension backend end to end and ADR-0026's decision moved
      from "ship both, indefinitely" to NetworkExtension as the sole
      macOS backend. Kept wrapped in a `productbuild`/`Distribution.xml`
      rather than shipping the one remaining `pkgbuild` output directly —
      costs nothing, and keeps re-adding a second component (e.g. a real
      App Store variant) cheap later.
    -->
    <choices-outline>
        <line choice="dev.karst.karststatus"/>
    </choices-outline>

    <choice id="dev.karst.karststatus" visible="false" title="Karst status indicator and setup helper">
        <pkg-ref id="dev.karst.karststatus"/>
    </choice>

    <pkg-ref id="dev.karst.karststatus">karst-status-component.pkg</pkg-ref>
</installer-gui-script>
