  Template. scripts/build-macos-pkg.sh copies this into the built .app
  bundle and patches CFBundleShortVersionString/CFBundleVersion with the
  real package version via `plutil -replace` — the "0.0.0" here is never
  what ships. Mirrors KarstStatus/Info.plist, one directory over: same
  pattern, a different CFBundleExecutable — a shell script this time, not
  a Swift binary, which `Contents/MacOS/<name>` neither knows nor cares
  about.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Karst Setup</string>
    <key>CFBundleDisplayName</key>
    <string>Karst Setup</string>
    <key>CFBundleIdentifier</key>
    <string>dev.karst.karstsetup</string>
    <key>CFBundleExecutable</key>
    <string>karst-setup</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!--
      Deliberately *not* LSUIElement, unlike KarstStatus's Info.plist next
      door. A background-agent app (no Dock icon, no Cmd-Tab entry) is right
      for something that runs continuously and is meant to be glanced at —
      wrong for something the user has to find and open once. Whether
      LSUIElement apps stay listed in Launchpad has varied across macOS
      versions and is not something to bet discoverability on for a tool
      whose entire job is being found and opened; a brief Dock icon while
      three dialogs go by costs nothing by comparison.
    -->
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright the Karst contributors. MIT OR Apache-2.0.</string>
</dict>
</plist>
