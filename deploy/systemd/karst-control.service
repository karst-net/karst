#
# The bare-metal coordination-server unit, for a host that built from this
# tree rather than installing a package.
#
# It differs from packaging/systemd/karst-control.service in the ExecStart
# path alone: `nfpm` installs to /usr/bin, GETTING-STARTED.md §6.2 installs
# the locally built binary to /usr/local/bin. Copying the packaging unit after
# a local `install` produces a service that fails at start with a path error
# naming a file the operator never meant to use.
#
# `EnvironmentFile=-` — the leading dash — keeps the unit startable with no
# control.env at all. That is deliberate rather than lenient: every variable
# in that file is optional to the binary, and each one's absence is reported
# by the server itself in terms of what stops working, which is a better
# diagnostic than systemd refusing to start over a missing file.

[Unit]
Description=Karst coordination service
Documentation=https://github.com/karst-net/karst
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/karst/control.env
ExecStart=/usr/local/bin/karst-control management --config /etc/netbird/management.json --datadir /var/lib/netbird --port 33073 --log-file console
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
