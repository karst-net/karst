#
# ADR-0008 §4's TURN fallback, opt-in -- Nomad has no `--profile` equivalent
# to compose's `--profile turn`, so "opt-in" here just means "a job you also
# choose to `nomad job run`." Generated by `../compose/bootstrap.sh --turn`
# (turnserver.conf, turn-secret, turns.json under ./state -- orchestrator-
# agnostic, nothing compose-specific). Not a replacement for the always-on
# relay in karst.nomad.hcl / prod/karst.nomad.hcl -- see that job's own
# comments and the compose README's TURN section.

variable "deploy_dir" {
  type    = string
  default = "."
}

variable "node_name" {
  type    = string
  default = "shannon"
}

job "karst-turn" {
  datacenters = ["dc1"]
  type        = "service"

  group "coturn" {
    count = 1

    constraint {
      attribute = "${attr.unique.hostname}"
      value     = var.node_name
    }

    task "coturn" {
      driver = "docker"

      config {
        image        = "coturn/coturn:4.6"
        # RFC 8656 allocates one relay port per active session out of the
        # range turnserver.conf opens (49160-49200 by default) -- the same
        # reason compose's coturn service uses network_mode: host rather
        # than mapping each port individually.
        network_mode = "host"
        args         = ["-c", "/etc/coturn/turnserver.conf"]
        volumes = [
          "${var.deploy_dir}/state/turnserver.conf:/etc/coturn/turnserver.conf:ro",
        ]
      }

      resources {
        cpu    = 200
        memory = 256
      }
    }
  }
}
