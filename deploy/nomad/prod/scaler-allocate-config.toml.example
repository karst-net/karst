#
# Template for this deployment's own ALLOCATE_CONFIG.toml (ADR-0063, #525).
# Copy this file outside version control -- it names subnet/security-group
# ids and a pat_file path, the same posture deployment.vars.hcl already has
# for this directory's other deployment secrets -- fill in the placeholders,
# and point karst.nomad.hcl's scaler_allocate_config variable at the copy.
#
# See docs/operations/scaler-aws-driver.md for what each [driver] field
# means and docs/OPERATIONS.md's "Scaler" section for how this task fits
# into this reference deployment.

control_api_base = "https://<karst_console_host>:33073/api"
# A UserRoleScaler-scoped PAT, trimmed of surrounding whitespace when read --
# authenticates every /relay-allocations/... call this loop makes. Managed
# separately from driver.enroll_pat_file below even when both point at the
# same file.
pat_file = "/etc/karst-scaler/allocate.pat"
poll_interval_secs = 15

[driver]
kind = "aws"
region = "us-east-1"
ami_id = "ami-0123456789abcdef0"
instance_type = "t3.micro"
subnet_id = "subnet-0123456789abcdef0"
security_group_ids = ["sg-0123456789abcdef0"]
# A UserRoleScaler-scoped PAT -- may be the same file as pat_file above, but
# each section here manages its own credential path.
enroll_pat_file = "/etc/karst-scaler/enroll.pat"
