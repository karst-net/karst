// Broken-KEM companion: shared secrets exposed; private PSK remains.
// SPDX-License-Identifier: CC-BY-4.0
// PHREATIC v1 — sole CNSA 2.0 key schedule (ADR-0018).
// Promoted from phreatic-nodh.vp; run: verifpal verify phreatic.vp.
// Symbolic design check: confidentiality, authentication, freshness, and
// transcript binding. No claims about side channels or implementation code.

attacker[active]

// ─── Long-term identity (spec §4, suite 0x0002) ──────────────────────────────
// a_kem/b_kem : ML-KEM-1024 static      psk : per-pair PSK from the netmap (§2.6)

principal Alice[
	knows public label, suite_id, psk_epoch, empty
	knows private psk
	knows private a_kem
	S_a = PUBKEY(a_kem)
]

principal Bob[
	knows public label, suite_id, psk_epoch, empty
	knows private psk
	knows private b_kem
	S_b = PUBKEY(b_kem)
]

// Netmap distribution — guarded, i.e. authenticated out of band.
Alice -> Bob: [S_a]
Bob -> Alice: [S_b]

// ─── HandshakeInit (spec §6.1/§6.5, key schedule §7.1 steps 1–6) ─────────────
// e_dh_pk is absent, not zero-filled (spec §6.1). Step 4 mixes only E_kem.

principal Alice[
	generates e_kem_sk, r_s, ts
	E_kem = PUBKEY(e_kem_sk)

	// peer_id_hint = HASH("Karst peer-id v1" || S_a)  — §4, session-independent,
	// SHA-512 under every suite including this one (§4's normative note).
	hint = HASH(label, S_a)

	// h0..h3 : transcript before any secret material.
	// suite_id AND psk_epoch are both bound here — see spec §13.2.
	// Step 4 (§7.1) mixes E_kem only — no E_dh under this suite.
	h0 = HASH(label)
	h1 = HASH(h0, suite_id, psk_epoch)
	h2 = HASH(h1, HASH(S_b))
	h3 = HASH(h2, E_kem)

	ss_s, ct_s = KEM_ENCAP[weak](S_b, r_s)      // PQ auth of responder — the only
	ck1, k1 = HKDF(h0, ss_s, label)       // authentication this suite has for it
	h4 = HASH(h3, ct_s)

	enc_ident = AEAD_ENC(k1, CONCAT(hint, ts), h4)
	h5 = HASH(h4, enc_ident)
]

Alice -> Bob: E_kem, ct_s, enc_ident

// ─── HandshakeResponse (spec §6.2/§6.5, §7.1 steps 7–10) ─────────────────────

principal Bob[
	ss_s_b = KEM_DECAP(b_kem, ct_s)
	ckb1, kb1 = HKDF(HASH(label), ss_s_b, label)

	hb0 = HASH(label)
	hb1 = HASH(hb0, suite_id, psk_epoch)
	hb2 = HASH(hb1, HASH(S_b))
	hb3 = HASH(hb2, E_kem)
	hb4 = HASH(hb3, ct_s)

	// Fails closed if the transcript differs — this is the binding check.
	ident_b = AEAD_DEC(kb1, enc_ident, hb4)?
	hb5 = HASH(hb4, enc_ident)

	generates r_e, r_ss

	ss_e,  ct_e  = KEM_ENCAP[weak](E_kem, r_e)   // forward secrecy
	ss_ss, ct_ss = KEM_ENCAP[weak](S_a, r_ss)    // PQ auth of initiator — the only
	ckb2, kb2 = HKDF(ckb1, ss_e,  label)   // authentication this suite has for it
	ckb3, kb3 = HKDF(ckb2, ss_ss, label)

	// PSK mixed LAST — gates the final key (ADR-0004 §3). Still holds: the
	// PSK is the one hedge this suite keeps (spec §7.2).
	ckb4, kb4 = HKDF(ckb3, psk, label)

	hb6 = HASH(hb5, ct_e, ct_ss)
	enc_empty = AEAD_ENC(kb4, empty, hb6)

	Tb_send, Tb_recv = HKDF(ckb4, empty, label)
]

Bob -> Alice: ct_e, ct_ss, enc_empty

// ─── Initiator completes, sends transport data (spec §8) ─────────────────────

principal Alice[
	ss_e_a  = KEM_DECAP(e_kem_sk, ct_e)
	ss_ss_a = KEM_DECAP(a_kem, ct_ss)
	cka2, ka2 = HKDF(ck1, ss_e_a,  label)
	cka3, ka3 = HKDF(cka2, ss_ss_a, label)
	cka4, ka4 = HKDF(cka3, psk, label)

	ha6 = HASH(h5, ct_e, ct_ss)
	_ = AEAD_DEC(ka4, enc_empty, ha6)?

	Ta_send, Ta_recv = HKDF(cka4, empty, label)

	generates payload
	data = AEAD_ENC(Ta_send, payload, empty)
]

Alice -> Bob: data

principal Bob[
	recovered = AEAD_DEC(Tb_send, data, empty)?
]

queries[
	// Transport confidentiality — the primary claim.
	confidentiality? payload

	// Mutual authentication, established once transport data flows.
	authentication? Alice -> Bob: data
	authentication? Bob -> Alice: enc_empty

	// HandshakeInit does not authenticate Alice: anyone with Bob's public
	// KEM key can generate ss_s and encrypt enc_ident. Authentication is
	// completed by the response and first transport message (spec §12.5).

	// The PSK must never be recoverable from the wire (§2.6).
	confidentiality? psk

	// Session keys must not leak.
	confidentiality? Ta_send

	// Replay resistance: the initiator's timestamp must be fresh.
	freshness? ts
]
